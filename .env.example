MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Set the provider CA as a PEM string with escaped newlines, or use MYSQL_SSL_CA_FILE locally.
# Leave both empty only if your provider's certificate chains to a public system CA.
MYSQL_SSL_CA_PEM=
MYSQL_SSL_CA_FILE=
GOOGLE_WEBHOOK_SECRET=
GOOGLE_FORM_URL=
RATE_LIMIT_SECRET=
SUBMISSION_FINGERPRINT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
# Explicit opt-in for local development only. Deployment ignores this switch.
LOCAL_SKIP_TURNSTILE=0
# For an isolated local MySQL server with a self-signed certificate only.
LOCAL_MYSQL_ALLOW_UNVERIFIED_TLS=0
CUSTOMER_TIME_ZONE=Asia/Kolkata
